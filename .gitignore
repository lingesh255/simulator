# Virtual Environment
.venv/
venv/
env/

# Python Cache
__pycache__/
*.pyc

# Logs
*.log

# ==========================================
# SIMULATOR PROJECT .GITIGNORE
# ==========================================

# ------------------------------------------
# 1. Python Environment & Cache
# ------------------------------------------
# This will globally ignore all __pycache__ folders regardless 
# of which directory (contracts, gui, services, etc.) they are in.
__pycache__/
*.py[cod]
*$py.class



# ------------------------------------------
# 2. Generated Map & Tile Data
# ------------------------------------------
# Ignores the entire tiles directory and all subfolders/images
data/tiles/
data/profiles/*.json
data/presets/*.json

# ------------------------------------------
# 3. IDE & Workspace Settings
# ------------------------------------------
# Keeps your personal VS Code editor settings local
.vscode/

# ------------------------------------------
# 4. PDDL / ENHSP mission planner
# ------------------------------------------
# ENHSP planner: cloned + built locally by scripts/setup_enhsp.ps1
tools/enhsp/

# Per-run generated PDDL problems and ENHSP output
plans/*/runs/

# ------------------------------------------
# 5. Standalone Renode + Pixhawk6C/6X package
# ------------------------------------------
# Local, required-to-run dependency (~700MB of Renode binaries and firmware
# images), not build output - never commit it. If it's ever missing, see
# renode_firmware_guide.md for how to regenerate it.
pixhawk6c_renode_standalone/